import getpass
import platform
import subprocess
from datetime import datetime


def get_local_accounts():
    """读取Windows本地账户名称"""

    powershell_code = (
        "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
        "Get-LocalUser | Select-Object -ExpandProperty Name"
    )

    result = subprocess.run(
        ["powershell.exe", "-NoProfile", "-Command", powershell_code],
        capture_output=True,
        encoding="utf-8",
        errors="replace"
    )

    if result.returncode != 0:
        print("本地账户读取失败：")
        print(result.stderr)
        return []

    accounts = []

    for line in result.stdout.splitlines():
        account = line.strip()

        if account:
            accounts.append(account)

    return accounts


print("===== 设备使用痕迹自查工具 =====")

computer_name = platform.node()
current_user = getpass.getuser()
system_name = platform.system()
system_version = platform.version()
system_architecture = platform.machine()
scan_time = datetime.now()

print(f"电脑名称：{computer_name}")
print(f"当前账户：{current_user}")
print(f"操作系统：{system_name}")
print(f"系统版本：{system_version}")
print(f"系统架构：{system_architecture}")
print(f"检查时间：{scan_time:%Y-%m-%d %H:%M:%S}")

print("\n===== 当前账户检查 =====")

trusted_accounts = {"李童尧"}

if current_user in trusted_accounts:
    print("当前正在使用可信账户")
else:
    print("当前正在使用陌生账户")

print("\n===== 本地账户检查 =====")

# Windows可能自动创建这些系统账户
system_accounts = {
    "Administrator",
    "DefaultAccount",
    "Guest",
    "WDAGUtilityAccount"
}

local_accounts = get_local_accounts()
unknown_accounts = []

for account in local_accounts:
    if account in trusted_accounts:
        print(f"[可信账户] {account}")

    elif account in system_accounts:
        print(f"[系统账户] {account}")

    else:
        print(f"[需要确认] {account}")
        unknown_accounts.append(account)

print("\n===== 检查结果 =====")

risk_score = len(unknown_accounts) * 50

if len(unknown_accounts) == 0:
    print("没有发现需要确认的本地账户")
else:
    print(f"发现 {len(unknown_accounts)} 个需要确认的账户：")

    for account in unknown_accounts:
        print(f"- {account}")

print(f"当前风险分数：{risk_score}")
